# Endereco do painel, de onde este app le os dados dos sites.
#
# INCLUA o caminho onde o painel esta montado. No Webflow Cloud o app vive sob
# um mount path, e a raiz do dominio e o site Webflow, nao o painel:
#   hoje:            https://projetoauto.webflow.io/app
#   dominio final:   https://crm.carbud.com.br/<mount path, se houver>
#   desenvolvimento: http://localhost:3000
# Ao trocar o dominio do painel, troque aqui (Environment Variables na Vercel)
# e faca um novo deploy do app dos sites.
PANEL_URL=

# Chave compartilhada com o painel (SITES_API_KEY la).
# Opcional: se o painel nao definir a dele, deixe vazia.
SITES_API_KEY=

# Revenda usada quando o dominio nao esta cadastrado.
# Serve para abrir o app em localhost e na URL *.vercel.app antes de existir
# dominio. NAO defina em producao: com ela vazia, dominio desconhecido da 404.
FALLBACK_TENANT_SLUG=
