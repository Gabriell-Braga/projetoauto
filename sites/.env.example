# Endereco do painel, de onde este app le os dados dos sites.
# Em desenvolvimento: http://localhost:3000
PANEL_URL=

# Chave compartilhada com o painel (SITES_API_KEY la).
# Opcional: se o painel nao definir a dele, deixe vazia.
SITES_API_KEY=

# Revenda usada quando o dominio nao esta cadastrado.
# Serve para abrir o app em localhost e na URL *.vercel.app antes de existir
# dominio. NAO defina em producao: com ela vazia, dominio desconhecido da 404.
FALLBACK_TENANT_SLUG=
